{
  "name": "EAGLE EYE",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "eagle_eye/inspector.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo xargs apt install -y <packages.txt; pip3 install --user -r eagle_eye/requirements.txt; echo '✅ Packages installed and Requirements met'",
  "postAttachCommand": {
    "console": "cd eagle_eye && python server.py --host 0.0.0.0 --no-browser",
    "streamlit": "streamlit run eagle_eye/app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8000": {
      "label": "EAGLE EYE console",
      "onAutoForward": "openPreview"
    },
    "8501": {
      "label": "Streamlit (lite)",
      "onAutoForward": "notify"
    }
  },
  "forwardPorts": [
    8000,
    8501
  ]
}
